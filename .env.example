# Copy to .env (gitignored) and fill in. Nothing here is read at import time
# except DATABASE_URL and AUTH_JWT_SECRET, so a partial file still boots.

# --- Core ---------------------------------------------------------------
# This project's own database. NOT the 3DF one.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cflft_dev?schema=public"
API_PORT=4000
NODE_ENV=development

# Signs access tokens (HS256). Any long random string; `openssl rand -hex 32`.
AUTH_JWT_SECRET=""

# HMAC key for signed unsubscribe / set-password links.
APP_SECRET=""

# --- Phase 1: migration from the old 3 Down Fantasy database -------------
# READ-ONLY source for scripts/inspectLegacy.ts and scripts/migrateFrom3df.ts.
#
# The 3DF database is NOT reachable over the LAN — its Postgres binds to
# localhost on the host machine (the 3DF container reached it via
# network_mode: host), so port 5432 is filtered from anywhere else. Dump on
# that machine and restore here:
#
#   # on the 3DF host
#   pg_dump -Fc -U postgres -d threedf -f threedf.dump
#   # then copy it over, and locally:
#   createdb threedf_legacy
#   pg_restore -d threedf_legacy --no-owner --no-privileges threedf.dump
#
# Keep a copy of the dump off-box. The Game.response blobs are the only
# surviving record of 2024/2025 play-by-play.
#
# The Game.response blobs in here are the only surviving copy of 2024/2025
# play-by-play — the upstream widget no longer serves it. Back the dump up
# off-box before doing anything else.
LEGACY_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/threedf_legacy?schema=public"

# --- Email (phase 3) -----------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="alerts@example.com"

# --- Scraping ------------------------------------------------------------
# Set when Chromium is not on the default path (the Docker image sets it).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
