// cflfantasytools schema.
//
// Ported from 3DFantasy/main with four structural corrections carried over from
// the port review: team metadata moves out of env vars into rows, notification
// prefs stop being nine denormalized booleans, scraper config becomes data, and
// auth gains real sessions so native can hold a token.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

// Emits the datamodel Pothos' PrismaPlugin needs — Prisma 7 no longer exposes
// DMMF on the client, so builder.ts reads it from here.
generator pothos {
  provider     = "prisma-pothos-types"
  clientOutput = "./prisma"
  output       = "../src/generated/pothos-types.ts"
}

// Prisma 7 is driver-adapter based: no `url` here. The connection string reaches
// the CLI via prisma.config.ts and the client via the pg adapter in db.server.ts.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

model Account {
  id        Int      @id @default(autoincrement())
  // Public identifier. PRESERVED VERBATIM on migration from 3DF — unsubscribe
  // links already sitting in inboxes embed it.
  uuid      String   @unique @default(uuid())
  email     String   @unique
  // bcrypt hash, carried over from 3DF unchanged so existing logins keep working.
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  subscriptions NotificationSubscription[]
  emails        EmailDelivery[]

  @@index([role])
}

// Refresh-token family. Only the SHA-256 of the token is stored; rotation
// replaces the row, and reuse of a rotated token revokes the whole family.
model Session {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(uuid())
  accountId     Int
  tokenHash     String    @unique
  userAgent     String?
  ip            String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  expiresAt     DateTime
  revokedAt     DateTime?
  // Set when this row supersedes another; lets a reused ancestor revoke the family.
  rotatedFromId Int?

  Account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Teams
// ---------------------------------------------------------------------------

// THREE ID SPACES, all 1:1 with a club and NONE interchangeable:
//   - `id`            our own surrogate key
//   - `geniusTeamId`  Genius/BetGenius competitorId ("106752"), joins play-by-play
//   - `gameZoneSquadId` CFL Game Zone squad id (1-9), joins the public JSON feeds
// Game Zone's 1-9 and 3DF's legacy positional 1-9 are NEARLY REVERSED (Game Zone
// 1 = OTT, 3DF 1 = SSK). Always map through `abbreviation`, never the integer.
model Team {
  id              Int     @id @default(autoincrement())
  uuid            String  @unique @default(uuid())
  slug            String  @unique
  abbreviation    String  @unique
  name            String
  nameFr          String?
  shortName       String?
  city            String?
  geniusTeamId    String? @unique
  gameZoneSquadId Int?    @unique
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sources         TeamSource[]
  depthChartLists DepthChartList[]
  depthCharts     DepthChart[]
  subscriptions   NotificationSubscription[]
  scrapeRuns      ScrapeRun[]
  Drives          Drive[]
  Plays           Play[]
  players         Player[]
  homeMatches     Match[]                    @relation("HomeMatches")
  awayMatches     Match[]                    @relation("AwayMatches")
}

// Scraper configuration as DATA, editable from the admin surface. In 3DF this
// lived in 27 env vars plus nine hand-written scraper modules, which is why the
// app silently kept scraping 2025 URLs into the 2026 season.
model TeamSource {
  id              Int     @id @default(autoincrement())
  teamId          Int
  kind            String  @default("depth-chart")
  url             String
  // Which extractor to run; see src/services/depthCharts/scrape/extractors.
  strategy        String
  // Strategy parameters (cell indexes, selectors, href filters, origin).
  config          Json    @default("{}")
  // Only teams whose page needs JS pay for a Chromium launch.
  requiresBrowser Boolean @default(false)
  enabled         Boolean @default(true)

  lastOkAt      DateTime?
  lastError     String?
  lastItemCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, kind])
}

// Replaces Account.team1Notification..team9Notification. A tenth club is now a
// row, not a migration plus a code change in five places.
model NotificationSubscription {
  id        Int      @id @default(autoincrement())
  accountId Int
  teamId    Int
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  Team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([accountId, teamId])
  @@index([teamId, enabled])
}

// ---------------------------------------------------------------------------
// Depth charts
// ---------------------------------------------------------------------------

// The last full snapshot seen for a (team, year) — the baseline the diff runs
// against. `value` is real Json now, not a JSON string.
model DepthChartList {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  teamId    Int
  year      Int
  value     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  depthCharts DepthChart[]

  // 3DF enforced "one list per (team, year)" in application code and returned a
  // 500 when it found two. Let the database hold the invariant instead.
  @@unique([teamId, year])
}

model DepthChart {
  id               Int      @id @default(autoincrement())
  uuid             String   @unique @default(uuid())
  teamId           Int
  depthChartListId Int
  title            String
  // The external href (usually a PDF on the club's own site).
  value            String
  year             Int
  season           String
  week             Int
  publishedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  Team           Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  DepthChartList DepthChartList @relation(fields: [depthChartListId], references: [id], onDelete: Cascade)

  @@index([teamId, year])
}

enum ScrapeStatus {
  OK
  FAILED
  REJECTED
}

// One row per scrape attempt — the data behind the admin "scraper health" panel,
// and the audit trail for the sanity gate that refuses an empty or collapsed result.
model ScrapeRun {
  id         Int          @id @default(autoincrement())
  teamId     Int
  status     ScrapeStatus
  itemCount  Int?
  addedCount Int?
  error      String?
  startedAt  DateTime     @default(now())
  finishedAt DateTime?

  Team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, startedAt])
}

// ---------------------------------------------------------------------------
// Email
// ---------------------------------------------------------------------------

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

model EmailDelivery {
  id        Int         @id @default(autoincrement())
  accountId Int?
  kind      String
  toEmail   String
  resendId  String?     @unique
  status    EmailStatus @default(QUEUED)
  error     String?
  // Groups a fan-out so a retried job can resume mid-batch instead of restarting.
  batchKey  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  Account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([batchKey])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Play-by-play
// ---------------------------------------------------------------------------

// Rule era, denormalized onto Game and Play so a model can filter without a
// join. Derived from season year at parse time by ruleEraForYear(); see
// docs/memory/project-cfl-rule-eras.md. NEVER pool eras in one fitted model —
// 2026 changed the scoring label distribution (modified rouge) and 2027 changes
// the yard-line domain itself (110 -> 100 yards).
enum RuleEra {
  PRE_2026
  E2026
  E2027
}

// Target zone, straight out of the play description ("pass complete short left
// to ..."). Depth x direction is the axis the whole zone model is built on.
enum PassDepth {
  SHORT
  DEEP
}

enum PassDirection {
  LEFT
  MIDDLE
  RIGHT
}

// `id` is the external BetGenius fixture id, not a sequence. `response` holds
// the raw widget payload — for 2024/2025 these blobs are the ONLY surviving
// copy, since the upstream widget now serves current-season data only.
//
// The blob is retained after parsing on purpose: it makes the parser re-runnable,
// so a parser bug is a re-parse rather than a data loss.
model Game {
  id        Int       @id
  uuid      String    @unique @default(uuid())
  response  String
  year      Int
  ruleEra   RuleEra?
  // Set when the parser last wrote Drive/Play rows for this game. Informational
  // only — `parsedHash` decides whether a re-parse is needed.
  parsedAt  DateTime?
  // md5 of the `response` this game was last parsed from. Null means never
  // parsed; a value differing from md5(response) means the payload changed and
  // the game needs re-parsing. Deliberately NOT a timestamp comparison: writing
  // parsedAt bumps @updatedAt on the same row, so updatedAt > parsedAt was
  // always true and every game re-parsed on every run.
  parsedHash String?
  // Number of plays written by the last successful parse.
  playCount Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  Drives Drive[]
  Plays  Play[]

  @@index([year])
  @@index([parsedAt])
}

model Drive {
  id               Int      @id @default(autoincrement())
  uuid             String   @unique @default(uuid())
  gameId           Int
  geniusTeamId     String
  number           Int
  isScoring        Boolean  @default(false)
  // Points on this drive, SIGNED from the possessing team's point of view.
  // Negative means the OPPONENT scored on this drive — a pick-six, a punt or
  // kickoff returned, a missed field goal run back. 121 scoring plays in the
  // 2023/24 corpus belong to a team other than the drive they sit in, so this
  // is a real case and not a theoretical one.
  points           Int?
  // The Expected Points training label: points on the next scoring drive, signed
  // relative to this drive's team. Null means the drive reached the end of a
  // half with no further score — an unusable training row, not a zero.
  nextPointOutcome Int?
  // Which quarter the drive started in. Half boundaries end a scoring search,
  // because a drive cannot be rewarded for points scored after the break.
  startQuarter     Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  Game  Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  Team  Team   @relation(fields: [geniusTeamId], references: [geniusTeamId], onDelete: Cascade)
  Plays Play[]

  @@unique([gameId, number])
}

model Play {
  id             Int     @id @default(autoincrement())
  uuid           String  @unique @default(uuid())
  gameId         Int
  geniusTeamId   String
  driveId        Int
  number         Int
  type           String
  subtype        String?
  description    String
  clock          String
  timestamp      BigInt
  phase          String
  phaseQualifier String
  isScoring      Boolean @default(false)
  startPosition  String
  endPosition    String?
  down           Int?
  distance       String?
  // Signed: negative means the yard line belongs to the possessing team.
  yardLine       Int?
  kicker         String?
  passer         String?
  rusher         String?
  // The intended TARGET of a pass, whether or not it was caught. A RECEPTION is
  // `receiver != null AND isComplete` — NOT `subtype = 'CompletePass'`, which
  // excludes every touchdown catch. See Play.isComplete.
  receiver       String?
  // Kept separate from `receiver` deliberately. 3DF stored the kick returner in
  // `receiver`, which would silently inflate every reception count.
  returner       String?
  defense        String?
  brokenUpBy     String?
  yardsGained    Int?
  puntYards      Int?
  returnYards    Int?
  epa            Float?

  ruleEra RuleEra?

  // --- target zone: the axis the OC/DC and projection models are built on ---
  targetDepth     PassDepth?
  targetDirection PassDirection?

  // Yards in the air to the catch point ("caught at CGY38" / "thrown to CGY17"),
  // measured from the line of scrimmage. Splits a completion into the quarterback's
  // contribution and the receiver's: yardsAfterCatch = yardsGained - airYards.
  airYards        Int?
  yardsAfterCatch Int?

  // "Shotgun", "No Huddle-Shotgun", "No Huddle".
  formation String?

  // Distance of a kick: field goal attempt length, punt yards, kickoff yards.
  kickDistance Int?
  // Field goal / convert only. Null on plays that are not a kick attempt.
  kickIsGood   Boolean?

  // Whether a pass was CAUGHT. Null on non-pass plays.
  //
  // Read from the description text rather than from `subtype`, because a caught
  // touchdown is subtype "Touchdown" and a completion that also drew a flag is
  // subtype "Penalty". Counting receptions off subtype alone loses 12% of
  // completions, every touchdown catch among them — the difference between
  // correct reconstructed fantasy points and quietly wrong ones.
  isComplete  Boolean?
  isFirstDown Boolean @default(false)
  isTurnover  Boolean @default(false)
  // A penalty wiped this snap ("NO PLAY"). It occupies no down and must be
  // excluded from any expected-points fit.
  isNoPlay    Boolean @default(false)

  penaltyTeam  String?
  penaltyName  String?
  penaltyYards Int?

  // Points scored ON THIS PLAY, signed positive for the play's own team. A
  // touchdown is 6 and its convert is a SEPARATE play worth 1 or 2 — summing
  // these over a drive gives the drive total exactly once.
  //
  // NEGATIVE SIX means a return touchdown: a punt or kickoff run back, a missed
  // field goal returned, a strip-sack picked up and carried in. The feed leaves
  // those with a null subtype, so they are read from the description, and they
  // are always scored by the side that did NOT have the ball. An interception
  // returned for a touchdown is different — the feed stamps that play with the
  // scoring team's own id, so it is a plain +6 on their row.
  points Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Game  Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  Drive Drive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  Team  Team  @relation(fields: [geniusTeamId], references: [geniusTeamId], onDelete: Cascade)

  @@unique([gameId, driveId, number])
  @@index([type, down])
  // The zone model's main read path: targets by zone within a rule era.
  @@index([ruleEra, targetDepth, targetDirection])
  @@index([receiver])
  @@index([passer])
  @@index([rusher])
}

// ---------------------------------------------------------------------------
// Background jobs
// ---------------------------------------------------------------------------

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

// Replaces 3DF's node-resque + Redis. The table is its own last-run record, so
// there is no scheduler daemon and no second service to operate.
model Job {
  id         Int       @id @default(autoincrement())
  kind       String
  payload    Json      @default("{}")
  status     JobStatus @default(PENDING)
  attempts   Int       @default(0)
  runAt      DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, runAt])
  @@index([kind, createdAt])
}

// ---------------------------------------------------------------------------
// CFL Game Zone feeds
//
// Three public, unauthenticated JSON feeds on gamezone.cfl.ca supply the player
// dimension 3DF never had, plus schedule and results. They are undocumented and
// unversioned, so ingestion validates shape, keeps the last good snapshot on a
// parse failure, and never deletes — a truncated feed must not be able to wipe
// 700 players.
// ---------------------------------------------------------------------------

enum FeedStatus {
  OK
  UNCHANGED
  INVALID
  FETCH_FAILED
}

// One row per fetch attempt. The sha256 lets an unchanged payload short-circuit,
// and retaining the payload means a bad deploy can be diagnosed after the fact.
model FeedSnapshot {
  id        Int        @id @default(autoincrement())
  source    String
  sha256    String
  status    FeedStatus
  payload   Json?
  error     String?
  itemCount Int?
  fetchedAt DateTime   @default(now())

  @@index([source, fetchedAt])
}

enum PlayerPosition {
  QUARTERBACK
  RUNNING_BACK
  WIDE_RECEIVER
  OTHER
}

model Player {
  id            Int            @id @default(autoincrement())
  uuid          String         @unique @default(uuid())
  // Game Zone's own player id — the feed's stable key.
  gameZoneId    Int            @unique
  // Upstream Genius feed id. The likely join into play-by-play participants,
  // though plays only name players as "#12 A.Smith" so resolution stays a
  // heuristic until proven.
  feedId        Int?
  firstName     String
  lastName      String
  teamId        Int?
  position      PlayerPosition @default(OTHER)
  status        String?
  isLocked      Boolean        @default(false)
  injuredTextEn String?
  // Absent from a feed pull for N consecutive syncs before being marked
  // inactive — never deleted.
  isActive      Boolean        @default(true)
  missedSyncs   Int            @default(0)
  firstSeenAt   DateTime       @default(now())
  lastSeenAt    DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  Team      Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  snapshots PlayerStatSnapshot[]
  points    PlayerGameweekPoints[]

  @@index([teamId, position])
  @@index([lastName])
}

// Salary, projection and cumulative stat line as of a point in time. Captured on
// every CHANGED payload because this is the one thing the feed cannot give us
// retroactively — miss a week and that week's price movement is gone for good.
model PlayerStatSnapshot {
  id               Int      @id @default(autoincrement())
  playerId         Int
  year             Int
  cost             Int?
  avgPoints        Float?
  projectedScores  Float?
  weekSalaryChange Int?
  totalPoints      Float?
  stats            Json
  capturedAt       DateTime @default(now())

  Player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, capturedAt])
}

model Gameweek {
  id         Int       @id @default(autoincrement())
  gameZoneId Int       @unique
  // Genius round id (gameweeks.json `feedId`); 2026 weeks run 1420012 upward.
  feedId     Int?
  name       String
  status     String
  year       Int
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  matches Match[]
  points  PlayerGameweekPoints[]

  @@index([year])
}

model Match {
  id              Int       @id @default(autoincrement())
  gameZoneId      Int       @unique
  gameweekId      Int
  homeTeamId      Int?
  awayTeamId      Int?
  homeScore       Int?
  awayScore       Int?
  status          String
  venue           String?
  date            DateTime?
  year            Int
  // Bridge to the BetGenius play-by-play. Populated by the PBP capture job,
  // which discovers ids from cfl.ca game pages.
  geniusFixtureId Int?      @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  Gameweek Gameweek               @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  HomeTeam Team?                  @relation("HomeMatches", fields: [homeTeamId], references: [id], onDelete: SetNull)
  AwayTeam Team?                  @relation("AwayMatches", fields: [awayTeamId], references: [id], onDelete: SetNull)
  points   PlayerGameweekPoints[]

  @@index([year, date])
}

// Fantasy points per player per gameweek, keyed by both the gameweek and (where
// known) the specific match.
model PlayerGameweekPoints {
  id         Int   @id @default(autoincrement())
  playerId   Int
  gameweekId Int
  matchId    Int?
  points     Float

  Player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  Gameweek Gameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  Match    Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@unique([playerId, gameweekId])
  @@index([gameweekId])
}
