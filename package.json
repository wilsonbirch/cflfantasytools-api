{
    "name": "cflfantasytools-api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "postinstall": "prisma generate",
        "generate": "prisma generate",
        "dev": "npm run generate && cross-env NODE_ENV=development tsx watch --env-file-if-exists=.env src/index.ts",
        "dev:worker": "npm run generate && cross-env NODE_ENV=development WORKER_IDLE_EXIT_MS=0 tsx watch --env-file-if-exists=.env src/worker/index.ts",
        "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
        "start:worker": "node --env-file-if-exists=.env --import tsx src/worker/index.ts",
        "build": "npm i && npx prisma generate",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run --project unit",
        "test:integration": "vitest run --project integration",
        "test:all": "vitest run",
        "test:coverage": "vitest run --coverage",
        "schema:print": "tsx scripts/printSchema.ts",
        "boot-smoke": "tsx test/smoke/boot-smoke.ts",
        "boot-smoke:worker": "tsx test/smoke/worker-boot-smoke.ts",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:studio": "prisma studio",
        "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
    },
    "dependencies": {
        "@pothos/core": "^4.13.1",
        "@pothos/plugin-errors": "^4.9.1",
        "@pothos/plugin-prisma": "^4.15.0",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "bcryptjs": "^3.0.2",
        "graphql": "^16.11.0",
        "graphql-scalars": "^1.24.2",
        "graphql-yoga": "^5.13.5",
        "jose": "^6.1.0",
        "linkedom": "^0.18.11",
        "pg": "^8.16.3",
        "puppeteer": "^24.15.0",
        "resend": "^4.7.0",
        "dotenv": "^17.2.0",
        "prisma": "^7.9.1",
        "tsx": "^4.20.3",
        "zod": "^4.0.5"
    },
    "devDependencies": {
        "@testcontainers/postgresql": "^11.2.1",
        "@types/node": "^22.16.5",
        "@types/pg": "^8.15.4",
        "@vitest/coverage-v8": "^4.1.10",
        "cross-env": "^10.0.0",
        "eslint": "^9.31.0",
        "globals": "^17.11.0",
        "jiti": "^2.5.1",
        "prettier": "^3.6.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.38.0",
        "vite": "^8.2.1",
        "vitest": "^4.1.6"
    }
}
